<Window x:Class="SoundSwap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SoundSwap"
        Width="460"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/SoundSwap.ico"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <StackPanel x:Name="Root" Margin="20,18,20,20">

        <!-- Header -->
        <Grid Margin="2,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Viewbox Width="42" Height="42">
                <Canvas Width="32" Height="32">
                    <Ellipse Canvas.Left="1" Canvas.Top="1" Width="30" Height="30" Fill="#2563EB" />
                    <Path Stroke="White" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M8,12 L8,20 M12,8 L12,24 M16,10 L16,22 M20,7 L20,25 M24,12 L24,20" />
                </Canvas>
            </Viewbox>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="SoundSwap" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="PC audio on your phone, phone mic on your PC" Style="{StaticResource Sub}" FontSize="12.5" />
            </StackPanel>
        </Grid>

        <!-- Connection status -->
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid Width="34" Height="34" Margin="0,0,14,0" VerticalAlignment="Top">
                    <Ellipse x:Name="StatusHalo" Opacity="0.15" Fill="{DynamicResource WarnBrush}" />
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{DynamicResource WarnBrush}" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusTitle" Text="Waiting for phone" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusDetail" Style="{StaticResource Sub}"
                               Text="Open SoundSwap on your phone; this PC will show up in the list automatically." />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Shown when a phone's USB network is "Public" and the firewall blocks it -->
        <Border x:Name="UsbBlockedCard" Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="Collapsed"
                BorderBrush="{DynamicResource WarnBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource RowIcon}" Background="Transparent">
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource RowIconGlyph}" Foreground="{DynamicResource WarnBrush}" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="USB connection is blocked" Style="{StaticResource Title}" />
                    <TextBlock x:Name="UsbBlockedText" Style="{StaticResource Sub}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="UsbAllowButton" Style="{StaticResource Primary}" Content="Allow" />
                        <TextBlock Text="Asks for administrator permission once." Style="{StaticResource Sub}"
                                   FontSize="11.5" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Audio directions -->
        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource RowIcon}">
                        <TextBlock Text="&#xE767;" Style="{StaticResource RowIconGlyph}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="Send PC audio to phone" Style="{StaticResource Title}" />
                        <TextBlock x:Name="SourceText" Style="{StaticResource Sub}" />
                    </StackPanel>
                    <CheckBox x:Name="SendSwitch" Grid.Column="2" Style="{StaticResource Switch}" VerticalAlignment="Top" Margin="0,4,0,0" />
                </Grid>
                <ProgressBar x:Name="SendMeter" Style="{StaticResource Meter}" Margin="48,12,0,0" />

                <Border Style="{StaticResource Divider}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource RowIcon}">
                        <TextBlock Text="&#xE720;" Style="{StaticResource RowIconGlyph}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="Use phone microphone" Style="{StaticResource Title}" />
                        <TextBlock x:Name="MicText" Style="{StaticResource Sub}" />
                        <StackPanel x:Name="MicSetupPanel" Visibility="Collapsed" Margin="0,10,0,0">
                            <Button x:Name="MicSetupButton" HorizontalAlignment="Left" />
                            <TextBlock x:Name="MicSetupNote" Style="{StaticResource Sub}" FontSize="11.5" Margin="0,8,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <CheckBox x:Name="MicSwitch" Grid.Column="2" Style="{StaticResource Switch}" VerticalAlignment="Top" Margin="0,4,0,0" />
                </Grid>
                <ProgressBar x:Name="MicMeter" Style="{StaticResource Meter}" Margin="48,12,0,0" />
            </StackPanel>
        </Border>

        <!-- Settings -->
        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Mute PC speakers while a phone is connected" Style="{StaticResource Title}" FontWeight="Normal" />
                        <TextBlock Text="Audio plays only on the phone." Style="{StaticResource Sub}" />
                    </StackPanel>
                    <CheckBox x:Name="MuteSwitch" Grid.Column="1" Style="{StaticResource Switch}" />
                </Grid>

                <Border Style="{StaticResource Divider}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Start with Windows" Style="{StaticResource Title}" FontWeight="Normal" />
                        <TextBlock Text="Runs quietly in the system tray after you sign in." Style="{StaticResource Sub}" />
                    </StackPanel>
                    <CheckBox x:Name="StartupSwitch" Grid.Column="1" Style="{StaticResource Switch}" />
                </Grid>

                <Border Style="{StaticResource Divider}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Microphone latency" Style="{StaticResource Title}" FontWeight="Normal" />
                    <TextBlock x:Name="BufferValue" Grid.Column="1" Style="{StaticResource Sub}" Margin="0" />
                </Grid>
                <Slider x:Name="BufferSlider" Style="{StaticResource Flat}" Minimum="10" Maximum="150"
                        TickFrequency="5" SmallChange="5" LargeChange="10" Margin="0,8,0,0" />
                <TextBlock Text="Lower values mean less delay. Increase it if the audio stutters." Style="{StaticResource Sub}" />

                <Border Style="{StaticResource Divider}" />

                <TextBlock Text="Microphone device" Style="{StaticResource Title}" FontWeight="Normal" />
                <ComboBox x:Name="MicDeviceCombo" Style="{StaticResource FlatCombo}" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Grid Margin="4,14,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Footer" Style="{StaticResource Sub}" FontSize="11.5" Margin="0" />
            <TextBlock x:Name="Stats" Grid.Column="1" Style="{StaticResource Sub}" FontSize="11.5" Margin="12,0,0,0" TextAlignment="Right" />
        </Grid>
    </StackPanel>
</Window>
